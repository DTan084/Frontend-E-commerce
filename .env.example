# Frontend Environment Variables

# App Configuration
REACT_APP_NAME=CodeMart
REACT_APP_DESCRIPTION=Marketplace for Source Code & Website Services
REACT_APP_VERSION=1.0.0

# Features Toggle
REACT_APP_ENABLE_ANALYTICS=false
REACT_APP_ENABLE_CHAT=false
REACT_APP_USE_MOCK_BACKEND=true
REACT_APP_USE_MOCK_CART=true

# Payment (for future integration)
# REACT_APP_STRIPE_PUBLIC_KEY=your_stripe_public_key
# REACT_APP_PAYPAL_CLIENT_ID=your_paypal_client_id

# CDN/Storage (for future)
# REACT_APP_CDN_URL=https://cdn.example.com
# REACT_APP_S3_BUCKET=your_bucket_name

# Social Login (for future)
# REACT_APP_GOOGLE_CLIENT_ID=your_google_client_id
# REACT_APP_FACEBOOK_APP_ID=your_facebook_app_id

# Development
REACT_APP_DEBUG_MODE=false
